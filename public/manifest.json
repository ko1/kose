{
  "manifest_version": 3,
  "name": "kose",
  "version": "0.1.0",
  "description": "選択した文章を、よい日本語・よい英語に改善します。",
  "minimum_chrome_version": "138",
  "incognito": "not_allowed",
  "permissions": ["contextMenus", "storage", "activeTab", "scripting"],
  "optional_host_permissions": ["https://api.openai.com/*", "https://api.anthropic.com/*"],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_title": "kose"
  },
  "commands": {
    "run-kose": {
      "suggested_key": { "default": "Alt+K" },
      "description": "選択した文章を、最後に選んだ仕上がりで kose にかける"
    }
  },
  "options_page": "options.html",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
